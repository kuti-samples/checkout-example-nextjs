# URL de tu propio backend — es quien crea la sesión de pago (POST /api/checkout)
# y confirma el estado del pago (GET /api/orders/:id). La usan tanto el navegador
# como el servidor de Next.js (la página /gracias verifica el pago server-side). Ver README.md.
NEXT_PUBLIC_STORE_API_URL=http://localhost:4000

# URL donde sirves el build de kuti-js (dist/kuti.global.js). Reemplázala por la URL del CDN
# oficial de KUTI en cuanto esté disponible — evita alojar tú mismo el script en producción,
# para seguir recibiendo parches de seguridad automáticamente.
NEXT_PUBLIC_KUTI_JS_URL=http://localhost:4001/kuti.global.js
